  {
   "num": "00",
   "title": "0 — Introduction: the log pose of sleep"
  },
  {
   "num": "01",
   "title": "1 — The ship's map: JDK, JRE and JVM"
  },
  {
   "num": "02",
   "title": "2 — Names and shapes: types, variables and operators"
  },
  {
   "num": "03",
   "title": "3 — Roads and turnings: loops, switch and methods"
  },
  {
   "num": "04",
   "title": "4 — Making things: classes, constructors and encapsulation"
  },
  {
   "num": "05",
   "title": "5 — Inheritance and many shapes: extends, super and dynamic dispatch"
  },
  {
   "num": "06",
   "title": "6 — The promise: interfaces and default methods"
  },
  {
   "num": "07",
   "title": "7 — Holding the storm: exceptions and try-with-resources"
  },
  {
   "num": "08",
   "title": "8 — Letters that do not move: String, equals and hashCode"
  },
  {
   "num": "09",
   "title": "9 — The engine room: class loaders, bytecode and the JIT"
  },
  {
   "num": "10",
   "title": "10 — The store of memory: heap, stack and garbage collection"
  },
  {
   "num": "11",
   "title": "11 — The tool box: javap, JFR, profiling and reflection"
  },
  {
   "num": "12",
   "title": "12 — The shape of the mould: generics, type erasure and PECS"
  },
  {
   "num": "13",
   "title": "13 — The store room: List, ArrayList and LinkedList"
  },
  {
   "num": "14",
   "title": "14 — Nami's map: the story inside HashMap"
  },
  {
   "num": "15",
   "title": "15 — Sets, lines and priority: Set, Queue and Deque"
  },
  {
   "num": "16",
   "title": "16 — The short order: lambdas and functional interfaces"
  },
  {
   "num": "17",
   "title": "17 — The flowing current: Stream, Collector and Optional"
  },
  {
   "num": "18",
   "title": "18 — New shapes: record, sealed, pattern matching and java.time"
  },
  {
   "num": "19",
   "title": "19 — Many hands: threads, synchronized and the memory model"
  },
  {
   "num": "20",
   "title": "20 — Sharing the work: executors, futures and virtual threads"
  },
  {
   "num": "21",
   "title": "21 — Joining the ship: Maven, the POM and the build"
  },
  {
   "num": "22",
   "title": "22 — The discipline of tests: JUnit, Mockito and the flaky test"
  },
  {
   "num": "23",
   "title": "23 — The store's ledger: SQL, JDBC and JPA"
  },
  {
   "num": "24",
   "title": "24 — The road of messages: HTTP, REST and Spring"
  },
  {
   "num": "25",
   "title": "25 — The screen and the shore: frontend, JavaFX and packaging"
  },
  {
   "num": "26",
   "title": "26 — The search for a word: Lucene, embeddings and semantic search"
  },
  {
   "num": "27",
