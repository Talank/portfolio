% cvstyle.sty -- every visual decision of the CV lives here.
% build.py writes calls to the macros below; cv.tex decides the section order.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/10/09 Academic CV style]

% ---------------------------------------------------------------- page + fonts
\RequirePackage[letterpaper,margin=0.8in,top=0.6in,bottom=0.7in]{geometry}
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{tgheros}
  \renewcommand{\familydefault}{\sfdefault}
\else
  \RequirePackage{fontspec}
  \setmainfont{texgyreheros}[
    Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
    ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\fi
\RequirePackage{microtype}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage{fontawesome5}
\RequirePackage[hidelinks,pdfusetitle]{hyperref}

\definecolor{accent}{HTML}{1F3A68}   % deep navy: name, headings, links
\definecolor{muted}{HTML}{5A6270}    % dates, venues, secondary text
\definecolor{rule}{HTML}{B8C2D3}
\definecolor{gold}{HTML}{A6761D}     % paper awards only

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.05}
\frenchspacing
\raggedbottom

% ---------------------------------------------------------------- header/footer
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{muted}\cvname\ -- Curriculum Vitae}
\fancyfoot[R]{\footnotesize\color{muted}Updated \cvupdated\quad\textbullet\quad\thepage\,/\,\pageref*{LastPage}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[R]{\footnotesize\color{muted}Updated \cvupdated\quad\textbullet\quad\thepage\,/\,\pageref*{LastPage}}}

\newcommand{\contact}[2]{{\color{accent}#1}\,#2}
\newcommand{\contactsep}{\hspace{0.9em}}

\newcommand{\makecvheader}{%
  \thispagestyle{plain}%
  \begin{center}
    {\fontsize{26}{30}\selectfont\color{accent}\bfseries\cvname}\par\vspace{4pt}
    {\large \cvtitle}\par\vspace{1pt}
    {\color{muted}\cvdepartment, \cvaffiliation\ \textbullet\ \cvaddress}\par\vspace{6pt}
    {\small
      \contact{\faEnvelope[regular]}{\href{mailto:\cvemail}{\cvemail}}\contactsep
      \contact{\faGlobe}{\href{https://\cvwebsite}{\cvwebsite}}\contactsep
      \contact{\faGithub}{\href{https://github.com/\cvgithub}{github.com/\cvgithub}}\contactsep
      \contact{\faLinkedin}{\href{https://linkedin.com/in/\cvlinkedin}{in/\cvlinkedin}}}
  \end{center}
  \vspace{2pt}}

% ---------------------------------------------------------------- sections
\titleformat{\section}
  {\large\bfseries\color{accent}}{}{0pt}{}[{\color{rule}\titlerule[0.6pt]}]
\titlespacing*{\section}{0pt}{10pt}{5pt}
\titleformat{\subsection}{\normalsize\itshape\color{accent}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{6pt}{3pt}

% Never leave a heading stranded at the bottom of a page.
\newcommand{\cvsection}[1]{\Needspace{4\baselineskip}\section*{#1}}
\newcommand{\cvsubsection}[1]{\subsection*{#1}}

% Left date column shared by every dated line.
\newlength{\datecol}\setlength{\datecol}{6.3em}

% \cventry{title}{from}{to}{organization}{location}{body}
% "from" sits beside the title and "to" beside the organization.
\newcommand{\cventry}[6]{%
  \par\noindent\begin{tabularx}{\linewidth}{@{}p{\datecol}@{}X@{}r@{}}
    \textcolor{muted}{\small #2} & \textbf{#1} & \textcolor{muted}{\small #5}\\
    \textcolor{muted}{\small #3} & \textit{#4} & \\
  \end{tabularx}\par
  \if\relax\detokenize{#6}\relax\else
    \vspace{-1pt}\hangindent=\datecol\hangafter=0 #6\par
  \fi
  \vspace{5pt}}

% \cvline{left label}{text}
\newcommand{\cvline}[2]{%
  \par\noindent\begin{tabularx}{\linewidth}{@{}p{\datecol}@{}X@{}}
    \textcolor{muted}{\small #1} & #2\\
  \end{tabularx}\par\vspace{3pt}}

\newenvironment{cvitems}
  {\begin{itemize}[leftmargin=\dimexpr\datecol+1.1em\relax,label={\color{accent}\textbullet},
                   topsep=0pt,itemsep=1pt,parsep=0pt]\small}
  {\end{itemize}}

% ---------------------------------------------------------------- publications
\newcommand{\me}[1]{\textbf{#1}}
\newenvironment{cvpubs}{\par}{\par}

% \cvpub{label}{venue tag}{authors}{title}{venue}{award}{links}
\newcommand{\cvpub}[7]{%
  \par\noindent\begin{tabularx}{\linewidth}{@{}p{\datecol}@{}X@{}}
    \textcolor{accent}{\bfseries[#1]}\newline\textcolor{muted}{\scriptsize #2}
    & #3.\ \textbf{#4}.\ #5.%
      \if\relax\detokenize{#6}\relax\else\newline #6\fi
      \if\relax\detokenize{#7}\relax\else\newline{\small #7}\fi\\
  \end{tabularx}\par\vspace{5pt}}

\newcommand{\awardicon}{\textcolor{gold}{\faTrophy}}
\newcommand{\pubaward}[1]{\textcolor{gold}{\faTrophy\ \textbf{#1}}}
\newcommand{\pubrate}[1]{\textcolor{muted}{Acceptance rate: #1}\quad}
\newcommand{\publink}[2]{\href{#1}{\textcolor{accent}{[#2]}}\ }

\endinput
